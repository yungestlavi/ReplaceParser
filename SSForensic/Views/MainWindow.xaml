<Window x:Class="SSForensic.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:SSForensic.ViewModels"
        Title="Replace Parser — made by yungestlavi"
        Height="1000" Width="1600"
        WindowStartupLocation="CenterScreen"
        TextElement.Foreground="#FFFFFF"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <!-- Continuous left-to-right drift, each layer at its own speed -->
                    <DoubleAnimation Storyboard.TargetName="Cloud1T" Storyboard.TargetProperty="X"
                                     From="-700" To="1700" Duration="0:2:10"/>
                    <DoubleAnimation Storyboard.TargetName="Cloud2T" Storyboard.TargetProperty="X"
                                     From="-900" To="1700" Duration="0:1:30"/>
                    <DoubleAnimation Storyboard.TargetName="Cloud3T" Storyboard.TargetProperty="X"
                                     From="-800" To="1700" Duration="0:1:05"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <!-- ====== ANIMATED CLOUD BACKGROUND ====== -->
        <Grid x:Name="CloudBackground">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#4A3B6E" Offset="0"/>
                    <GradientStop Color="#6E5BA0" Offset="0.35"/>
                    <GradientStop Color="#9D8BC8" Offset="0.7"/>
                    <GradientStop Color="#D4C5EC" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <!-- Layer 1: slow, large, soft -->
            <Canvas x:Name="CloudLayer1" Opacity="0.55">
                <Canvas.RenderTransform><TranslateTransform x:Name="Cloud1T" X="0"/></Canvas.RenderTransform>
                <Ellipse Canvas.Left="0" Canvas.Top="120" Width="380" Height="150" Fill="#FFFFFF" Opacity="0.7">
                    <Ellipse.Effect><BlurEffect Radius="35"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Canvas.Left="500" Canvas.Top="80" Width="460" Height="170" Fill="#F5F0FF" Opacity="0.65">
                    <Ellipse.Effect><BlurEffect Radius="40"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Canvas.Left="1050" Canvas.Top="150" Width="400" Height="160" Fill="#FFFFFF" Opacity="0.6">
                    <Ellipse.Effect><BlurEffect Radius="38"/></Ellipse.Effect>
                </Ellipse>
            </Canvas>

            <!-- Layer 2: medium, denser puffs -->
            <Canvas x:Name="CloudLayer2" Opacity="0.60">
                <Canvas.RenderTransform><TranslateTransform x:Name="Cloud2T" X="0"/></Canvas.RenderTransform>
                <Ellipse Canvas.Left="0" Canvas.Top="430" Width="500" Height="200" Fill="#FFFFFF" Opacity="0.75">
                    <Ellipse.Effect><BlurEffect Radius="42"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Canvas.Left="250" Canvas.Top="470" Width="350" Height="150" Fill="#FFFFFF" Opacity="0.7">
                    <Ellipse.Effect><BlurEffect Radius="35"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Canvas.Left="650" Canvas.Top="500" Width="560" Height="220" Fill="#F3E5FF" Opacity="0.7">
                    <Ellipse.Effect><BlurEffect Radius="45"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Canvas.Left="1150" Canvas.Top="450" Width="500" Height="210" Fill="#FFFFFF" Opacity="0.7">
                    <Ellipse.Effect><BlurEffect Radius="42"/></Ellipse.Effect>
                </Ellipse>
            </Canvas>

            <!-- Layer 3: faster, bottom, bright -->
            <Canvas x:Name="CloudLayer3" Opacity="0.50">
                <Canvas.RenderTransform><TranslateTransform x:Name="Cloud3T" X="0"/></Canvas.RenderTransform>
                <Ellipse Canvas.Left="0" Canvas.Top="800" Width="460" Height="180" Fill="#FFFFFF" Opacity="0.8">
                    <Ellipse.Effect><BlurEffect Radius="38"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Canvas.Left="300" Canvas.Top="840" Width="320" Height="140" Fill="#FFFFFF" Opacity="0.75">
                    <Ellipse.Effect><BlurEffect Radius="32"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Canvas.Left="700" Canvas.Top="820" Width="520" Height="200" Fill="#F5F0FF" Opacity="0.75">
                    <Ellipse.Effect><BlurEffect Radius="40"/></Ellipse.Effect>
                </Ellipse>
            </Canvas>

           <!-- Scrim: very light before analysis (clouds show through), darker after Run -->
            <Rectangle Opacity="{Binding HasRun, Converter={StaticResource HasRunToScrim}}">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#330A0A14" Offset="0"/>
                        <GradientStop Color="#550A0A14" Offset="0.5"/>
                        <GradientStop Color="#770A0A14" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- ====== FOREGROUND UI ====== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="340" MinHeight="100"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="0,28,0,16" Background="#33000000">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Replace Parser" HorizontalAlignment="Center"
                               FontSize="56" FontWeight="Bold" Foreground="#FFFFFF">
                        <TextBlock.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#5B3B8A" Opacity="0.9"/></TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="made by yungestlavi" HorizontalAlignment="Center"
                               FontSize="13" Opacity="0.8" FontStyle="Italic" Margin="0,2,0,18"/>
                    <Button Command="{Binding RunAnalysisCommand}" Width="280" Height="48"
                            FontSize="18" FontWeight="Bold"
                            Background="#9575CD" BorderBrush="#7E57C2" Foreground="#FFFFFF"
                            IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InvertBooleanConverter}}"
                            Style="{StaticResource MaterialDesignRaisedButton}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Play" Width="22" Height="22" Margin="0,0,8,0"/>
                            <TextBlock Text="RUN ANALYSIS"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Background="#44000000" Padding="20,8">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Drive:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="40" Text="{Binding DriveLetter, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding LastBootInfo}" Margin="20,0,0,0" Opacity="0.8" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Command="{Binding CancelCommand}"
                            IsEnabled="{Binding IsAnalyzing}" Style="{StaticResource MaterialDesignOutlinedButton}"
                            BorderBrush="#FFFFFF" Foreground="#FFFFFF">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Stop" Margin="0,0,4,0"/>
                            <TextBlock Text="Cancel"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Command="{Binding OpenServicesCommand}"
                            Margin="0,0,10,0" Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#7E57C2" BorderBrush="#7E57C2" Foreground="#FFFFFF">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Cogs" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="SERVICES" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Command="{Binding CheckUpdatesCommand}"
                            IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InvertBooleanConverter}}"
                            Margin="0,0,10,0" Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="#5E35B1" BorderBrush="#5E35B1" Foreground="#FFFFFF">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CloudDownload" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="CHECK UPDATES" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Border>

            <Border Grid.Row="2" Background="#33000000" Padding="20,10">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="FilterVariant" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#D1C4E9"/>
                    <TextBlock Text="Extensions" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <ItemsControl ItemsSource="{Binding Extensions}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#33FFFFFF" CornerRadius="14" Padding="8,2" Margin="0,2,8,2">
                                    <CheckBox Content="{Binding Extension}" IsChecked="{Binding IsEnabled}" Foreground="#FFFFFF" FontSize="12"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="#669575CD" CornerRadius="14" Padding="10,2" Margin="12,2,0,2">
                        <CheckBox IsChecked="{Binding DetectSuspiciousExt}" Foreground="#FFFFFF" FontSize="12" FontWeight="Bold">
                            <CheckBox.Content>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="AlertCircle" Margin="0,0,4,0" Foreground="#FFFFFF" Width="14" Height="14"/>
                                    <TextBlock Text="Modified extensions " Foreground="#FFFFFF"/>
                                    <TextBlock Text="(may false flag)" Foreground="#FFD54F" FontStyle="Italic"/>
                                </StackPanel>
                            </CheckBox.Content>
                        </CheckBox>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="#44000000" Padding="20,10">
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="ALL" Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="#FFFFFF" Background="#55666688" Margin="0,0,8,0" Padding="16,8">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ViewList" Margin="0,0,6,0"/><TextBlock Text="All " FontWeight="Bold"/><TextBlock Text="{Binding TotalRecords}"/></StackPanel>
                    </Button>
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="RENAMES" Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="#FFFFFF" Background="#CCE53935" Margin="0,0,8,0" Padding="16,8">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Rename" Margin="0,0,6,0"/><TextBlock Text="Renames " FontWeight="Bold"/><TextBlock Text="{Binding RenameReplaces}"/></StackPanel>
                    </Button>
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="CHEATS" Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="#FFFFFF" Background="#CC1E88E5" Margin="0,0,8,0" Padding="16,8">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="Bug" Margin="0,0,6,0"/><TextBlock Text="Cheats " FontWeight="Bold"/><TextBlock Text="{Binding CheatHits}"/></StackPanel>
                    </Button>
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="UNSIGNED" Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="#FFFFFF" Background="#CCFB8C00" Margin="0,0,8,0" Padding="16,8">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ShieldOff" Margin="0,0,6,0"/><TextBlock Text="Unsigned " FontWeight="Bold"/><TextBlock Text="{Binding UnsignedHits}"/></StackPanel>
                    </Button>
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="LEGIT" Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="#FFFFFF" Background="#CC43A047" Margin="0,0,8,0" Padding="16,8">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="ShieldCheck" Margin="0,0,6,0"/><TextBlock Text="Legit " FontWeight="Bold"/><TextBlock Text="{Binding LegitHits}"/></StackPanel>
                    </Button>
                    <Button Command="{Binding SetFilterCommand}" CommandParameter="SPOOFED" Style="{StaticResource MaterialDesignFlatButton}"
                            Foreground="#FFFFFF" Background="#CC8E24AA" Margin="0,0,8,0" Padding="16,8">
                        <StackPanel Orientation="Horizontal"><materialDesign:PackIcon Kind="FileQuestion" Margin="0,0,6,0"/><TextBlock Text="Spoofed " FontWeight="Bold"/><TextBlock Text="{Binding SpoofedHits}"/></StackPanel>
                    </Button>
                    <TextBlock VerticalAlignment="Center" Margin="20,0,0,0" Opacity="0.85">
                        <Run Text="Active: "/><Run Text="{Binding ActiveFilter}" FontWeight="Bold" Foreground="#E1BEE7"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Background="#33000000" Padding="20,4,20,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Grid.Column="0" Kind="Magnify" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#D1C4E9"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Search by filename or path..."
                             materialDesign:HintAssist.IsFloating="False" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             VerticalAlignment="Center" FontSize="14"/>
                    <Button Grid.Column="2" Command="{Binding ClearSearchCommand}" Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="8,0,0,0" Padding="10,6" ToolTip="Clear search">
                        <materialDesign:PackIcon Kind="CloseCircle"/>
                    </Button>
                </Grid>
            </Border>

            <DataGrid Grid.Row="5" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      Background="#55000000" Foreground="#FFFFFF" RowBackground="#33000000" AlternatingRowBackground="#44000000"
                      GridLinesVisibility="None" RowHeight="36"
                      materialDesign:DataGridAssist.CellPadding="10,4" materialDesign:DataGridAssist.ColumnHeaderPadding="10,6">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="File" Binding="{Binding ReplacementFileName}" Width="200"/>
                    <DataGridTextColumn Header="Original Path" Binding="{Binding OriginalPath}" Width="280"/>
                    <DataGridTextColumn Header="Replacement Path" Binding="{Binding ReplacementPath}" Width="280"/>
                    <DataGridTextColumn Header="Replace Time (UTC)" Binding="{Binding ReplaceTimestamp, StringFormat=u}" Width="160"/>
                    <DataGridTextColumn Header="Modified" Binding="{Binding ReplacementLastModified, StringFormat=u}" Width="160"/>
                    <DataGridTemplateColumn Header="Ext" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DeclaredExtension}" FontWeight="SemiBold"/>
                                    <TextBlock Text=" → " Opacity="0.6" Visibility="{Binding ExtensionSpoofed, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding DetectedFormat}" Foreground="#FFD54F" FontWeight="Bold" Visibility="{Binding ExtensionSpoofed, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Trust" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding ReplacementTrust, Converter={StaticResource TrustToBrush}}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding ReplacementTrust}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="6" Height="6" HorizontalAlignment="Stretch" Background="#9575CD"
                          ResizeBehavior="PreviousAndNext" Cursor="SizeNS" ShowsPreview="True"/>

            <Border Grid.Row="7" Background="#66000000" Padding="20,14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <materialDesign:PackIcon Kind="InformationOutline" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#D1C4E9"/>
                            <TextBlock Text="DETAILS" FontWeight="Bold" FontSize="14"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Opacity="0.7" Text="{Binding SelectedRecord.ReplacementFileName, StringFormat='Selected: {0}'}"/>
                    </DockPanel>
                    <Grid Grid.Row="1" Visibility="{Binding SelectedRecord, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200"/><ColumnDefinition Width="*" MinWidth="200"/><ColumnDefinition Width="2*" MinWidth="300"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#553A2B5E" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="ORIGINAL FILE" FontWeight="Bold" Margin="0,0,0,10" Foreground="#D1C4E9"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,3"><Run Text="Name: " FontWeight="SemiBold"/><Run Text="{Binding SelectedRecord.OriginalFileName}"/></TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,3"><Run Text="Path: " FontWeight="SemiBold"/><Run Text="{Binding SelectedRecord.OriginalPath}"/></TextBlock>
                                    <TextBlock Margin="0,3"><Run Text="Trust: " FontWeight="SemiBold"/><Run Text="{Binding SelectedRecord.OriginalTrust}"/></TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,3"><Run Text="Created: " FontWeight="SemiBold"/><Run Text="{Binding SelectedRecord.OriginalCreated, StringFormat=u}"/></TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,3"><Run Text="Modified: " FontWeight="SemiBold"/><Run Text="{Binding SelectedRecord.OriginalLastModified, StringFormat=u}"/></TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,3"><Run Text="Accessed: " FontWeight="SemiBold"/><Run Text="{Binding SelectedRecord.OriginalLastAccessed, StringFormat=u}"/></TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Background="#553A2B5E" CornerRadius="8" Padding="14" Margin="0,0,8,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="REPLACEMENT FILE" FontWeight="Bold" Margin="0,0,0,10" Foreground="#D1C4E9"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,3"><Run Text="Name: " FontWeight="SemiBold"/><Run Text="{Binding SelectedRecord.ReplacementFileName}"/></TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,3"><Run Text="Path: " FontWeight="SemiBold"/><Run Text="{Binding SelectedRecord.ReplacementPath}"/></TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,3"><Run Text="SHA256: " FontWeight="SemiBold"/><Run Text="{Binding SelectedRecord.ReplacementHash}"/></TextBlock>
                                    <TextBlock Margin="0,3"><Run Text="Trust: " FontWeight="SemiBold"/><Run Text="{Binding SelectedRecord.ReplacementTrust}"/></TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,3"><Run Text="Signer: " FontWeight="SemiBold"/><Run Text="{Binding SelectedRecord.ReplacementSigner}"/></TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,3"><Run Text="Detected Format: " FontWeight="SemiBold"/><Run Text="{Binding SelectedRecord.DetectedFormat}"/></TextBlock>

                                    <TextBlock Margin="0,8,0,3" FontWeight="Bold" Foreground="#D1C4E9">DIGITAL SIGNATURE:</TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,1"><Run Text="Verdict: " FontWeight="SemiBold"/><Run Text="{Binding SelectedRecord.SignatureVerdict}"/></TextBlock>
                                    <Border Background="#66000000" CornerRadius="6" Padding="8" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding SelectedRecord.SignatureDetails}" TextWrapping="Wrap"
                                                   FontFamily="Consolas, Courier New, monospace" FontSize="11.5" Foreground="#E8E0F5"/>
                                    </Border>

                                    <TextBlock Margin="0,8,0,3" FontWeight="Bold" Foreground="#D1C4E9">YARA MATCHES:</TextBlock>
                                    <ItemsControl ItemsSource="{Binding SelectedRecord.YaraMatches}">
                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="#FF8A80" Margin="0,1"/></DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="2" Background="#553A2B5E" CornerRadius="8" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="USN REASONS &amp; PATTERN TIMELINE" FontWeight="Bold" Margin="0,0,0,10" Foreground="#D1C4E9"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedEvidence}" AutoGenerateColumns="False" IsReadOnly="True"
                                          HeadersVisibility="Column" RowHeight="28" Background="#66000000" Foreground="#FFFFFF"
                                          GridLinesVisibility="Horizontal" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                          CanUserResizeColumns="True" CanUserSortColumns="True" materialDesign:DataGridAssist.CellPadding="8,2">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="When (UTC)" Binding="{Binding Timestamp, StringFormat=u}" Width="150"/>
                                        <DataGridTextColumn Header="USN Reason / Pattern" Binding="{Binding Description}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                    <Setter Property="VerticalAlignment" Value="Top"/>
                                                    <Setter Property="Margin" Value="0,4"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Raw" Binding="{Binding RawData}" Width="220">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontFamily" Value="Consolas"/>
                                                    <Setter Property="FontSize" Value="11"/>
                                                    <Setter Property="Opacity" Value="0.85"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="8" Background="#55000000" Padding="16,6">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding UpdateStatusText}" VerticalAlignment="Center"
                               Foreground="#D1C4E9" Opacity="0.9" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ====== CENTERED LOADING OVERLAY (visible only while analyzing) ====== -->
        <Grid Background="#99100A1E"
              Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    CornerRadius="18" Padding="48,40" Background="#CC2A1A47">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <!-- Spinning circle -->
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 IsIndeterminate="True"
                                 Width="86" Height="86" Margin="0,0,0,28"
                                 Foreground="#B39DDB"
                                 HorizontalAlignment="Center"/>

                    <TextBlock Text="Analyzing…" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF"
                               HorizontalAlignment="Center" Margin="0,0,0,16">
                        <TextBlock.Effect><DropShadowEffect Color="#5B3B8A" BlurRadius="10" ShadowDepth="0"/></TextBlock.Effect>
                    </TextBlock>

                    <!-- Linear progress bar with percentage -->
                    <ProgressBar Value="{Binding ProgressValue}" Maximum="100"
                                 Width="320" Height="12"
                                 Foreground="#9575CD" Background="#33FFFFFF"/>
                    <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0"
                               FontSize="15" FontWeight="SemiBold" Foreground="#EDE7F6"
                               Text="{Binding ProgressValue, StringFormat={}{0}%}"/>

                    <!-- Live status line -->
                    <TextBlock Text="{Binding StatusText}" FontSize="12.5" Foreground="#CFC2E8"
                               HorizontalAlignment="Center" Margin="0,14,0,0"
                               MaxWidth="340" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>