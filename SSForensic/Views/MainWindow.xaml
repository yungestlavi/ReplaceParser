<Window x:Class="SSForensic.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:SSForensic.ViewModels"
        Title="Replace Parser"
        Icon="/app.ico"
        Height="900" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBase}"
        TextElement.Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI"
        FontSize="12">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Top toolbar: search + checkboxes + buttons -->
            <RowDefinition Height="Auto"/>   <!-- Drive + extensions row -->
            <RowDefinition Height="Auto"/>   <!-- Filter chips -->
            <RowDefinition Height="*" MinHeight="200"/>   <!-- Main grid -->
            <RowDefinition Height="4"/>      <!-- Splitter -->
            <RowDefinition Height="280" MinHeight="100"/> <!-- Details -->
            <RowDefinition Height="Auto"/>   <!-- Status bar -->
        </Grid.RowDefinitions>

        <!-- ===== TOP TOOLBAR: search + options + action buttons ===== -->
        <Border Grid.Row="0" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1" Padding="10,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="#1F2125" Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource Border1}" BorderThickness="1"
                         Padding="8,5" VerticalAlignment="Center" Tag="Search..."/>

                <!-- Checkboxes -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding DetectSuspiciousExt}" Foreground="{StaticResource TextPrimary}" Margin="0,0,20,0">
                        <TextBlock Text="Modified Extensions"/>
                    </CheckBox>
                </StackPanel>

                <!-- Spacer -->
                <Grid Grid.Column="2"/>

                <!-- Action buttons -->
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button Command="{Binding RunAnalysisCommand}"
                            IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InvertBooleanConverter}}"
                            Background="#3D4147" Foreground="{StaticResource TextPrimary}"
                            BorderBrush="{StaticResource Border1}" BorderThickness="1"
                            Padding="14,6" Margin="0,0,6,0" Content="Parse again"/>
                    <Button Command="{Binding CancelCommand}"
                            IsEnabled="{Binding IsAnalyzing}"
                            Background="#3D4147" Foreground="{StaticResource TextPrimary}"
                            BorderBrush="{StaticResource Border1}" BorderThickness="1"
                            Padding="14,6" Margin="0,0,6,0" Content="Cancel"/>
                    <Button Command="{Binding OpenServicesCommand}"
                            Background="#3D4147" Foreground="{StaticResource TextPrimary}"
                            BorderBrush="{StaticResource Border1}" BorderThickness="1"
                            Padding="14,6" Margin="0,0,6,0" Content="Services"/>
                    <Button Command="{Binding CheckUpdatesCommand}"
                            IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InvertBooleanConverter}}"
                            Background="#3D4147" Foreground="{StaticResource TextPrimary}"
                            BorderBrush="{StaticResource Border1}" BorderThickness="1"
                            Padding="14,6" Content="Check Updates"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== DRIVE + EXTENSIONS ROW ===== -->
        <Border Grid.Row="1" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Drive:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Width="42" Text="{Binding DriveLetter, UpdateSourceTrigger=PropertyChanged}"
                         Background="#1F2125" Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource Border1}" BorderThickness="1"
                         Padding="6,3" HorizontalContentAlignment="Center"
                         FontFamily="Consolas" VerticalAlignment="Center"/>
                <Rectangle Width="1" Fill="{StaticResource Border1}" Margin="14,2,14,2"/>
                <TextBlock Text="Extensions:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ItemsControl ItemsSource="{Binding Extensions}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Extension}" IsChecked="{Binding IsEnabled}"
                                      Foreground="{StaticResource TextPrimary}" Margin="0,0,12,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Rectangle Width="1" Fill="{StaticResource Border1}" Margin="14,2,14,2"/>
                <TextBlock Text="{Binding LastBootInfo}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                           FontFamily="Consolas"/>
            </StackPanel>
        </Border>

        <!-- ===== FILTER CHIPS ===== -->
        <Border Grid.Row="2" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1" Padding="10,4">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding SetFilterCommand}" CommandParameter="ALL"
                        Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                        Padding="8,4" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="All "/>
                        <TextBlock Text="{Binding TotalRecords}" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetFilterCommand}" CommandParameter="RENAMES"
                        Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                        Padding="8,4" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Renames "/>
                        <TextBlock Text="{Binding RenameReplaces}" Foreground="#E06C75"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetFilterCommand}" CommandParameter="CHEATS"
                        Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                        Padding="8,4" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cheats "/>
                        <TextBlock Text="{Binding CheatHits}" Foreground="#61AFEF"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetFilterCommand}" CommandParameter="UNSIGNED"
                        Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                        Padding="8,4" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Unsigned "/>
                        <TextBlock Text="{Binding UnsignedHits}" Foreground="#E06C75"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetFilterCommand}" CommandParameter="LEGIT"
                        Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                        Padding="8,4" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Legit "/>
                        <TextBlock Text="{Binding LegitHits}" Foreground="#7EC07E"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetFilterCommand}" CommandParameter="SPOOFED"
                        Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                        Padding="8,4" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Spoofed "/>
                        <TextBlock Text="{Binding SpoofedHits}" Foreground="#C678DD"/>
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Fill="{StaticResource Border1}" Margin="12,4,12,4"/>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextMuted}">
                    <Run Text="Active: "/><Run Text="{Binding ActiveFilter}" Foreground="{StaticResource TextPrimary}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ===== MAIN GRID ===== -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  Background="{StaticResource BgBase}" Foreground="{StaticResource TextPrimary}"
                  RowBackground="{StaticResource BgRow}" AlternatingRowBackground="{StaticResource BgRowAlt}"
                  BorderThickness="0" GridLinesVisibility="None" RowHeight="22"
                  HorizontalGridLinesBrush="#3D4147"
                  materialDesign:DataGridAssist.CellPadding="8,2"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8,4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Replace Time" Binding="{Binding ReplaceTimestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="155">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="11.5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="File" Binding="{Binding ReplacementFileName}" Width="200"/>
                <DataGridTextColumn Header="Original Path" Binding="{Binding OriginalPath}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="11.5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Replacement Path" Binding="{Binding ReplacementPath}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="11.5"/>
                            <Setter Property="Foreground" Value="#E06C75"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Ext" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DeclaredExtension}" FontFamily="Consolas" FontSize="11.5"/>
                                <TextBlock Text=" → " Foreground="{StaticResource TextMuted}"
                                           Visibility="{Binding ExtensionSpoofed, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding DetectedFormat}" Foreground="#C678DD" FontFamily="Consolas" FontSize="11.5"
                                           Visibility="{Binding ExtensionSpoofed, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Signature" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ReplacementTrust}"
                                       Foreground="{Binding ReplacementTrust, Converter={StaticResource TrustToBrush}}"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="4" Height="4" HorizontalAlignment="Stretch" Background="{StaticResource Border1}"
                      ResizeBehavior="PreviousAndNext" Cursor="SizeNS" ShowsPreview="True"/>

        <!-- ===== DETAILS ===== -->
        <Border Grid.Row="5" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource Border1}" BorderThickness="0,1,0,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#2F3236" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1" Padding="10,6">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Details" Foreground="{StaticResource TextSecondary}"/>
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="11"
                                   Text="{Binding SelectedRecord.ReplacementFileName, StringFormat='Selected: {0}'}"/>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="1" Visibility="{Binding SelectedRecord, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240"/>
                        <ColumnDefinition Width="*" MinWidth="280"/>
                        <ColumnDefinition Width="2*" MinWidth="320"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="12,10" Background="{StaticResource BgRow}">
                        <StackPanel>
                            <TextBlock Text="ORIGINAL FILE" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="Name: " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding SelectedRecord.OriginalFileName}"/></TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,2" FontFamily="Consolas" FontSize="11.5"><Run Text="Path: " Foreground="{StaticResource TextMuted}" FontFamily="Segoe UI"/><Run Text="{Binding SelectedRecord.OriginalPath}"/></TextBlock>
                            <TextBlock Margin="0,2"><Run Text="Trust: " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding SelectedRecord.OriginalTrust}"/></TextBlock>
                            <TextBlock Margin="0,2" FontFamily="Consolas" FontSize="11.5"><Run Text="Created: " Foreground="{StaticResource TextMuted}" FontFamily="Segoe UI"/><Run Text="{Binding SelectedRecord.OriginalCreated, StringFormat=u}"/></TextBlock>
                            <TextBlock Margin="0,2" FontFamily="Consolas" FontSize="11.5"><Run Text="Modified: " Foreground="{StaticResource TextMuted}" FontFamily="Segoe UI"/><Run Text="{Binding SelectedRecord.OriginalLastModified, StringFormat=u}"/></TextBlock>
                            <TextBlock Margin="0,2" FontFamily="Consolas" FontSize="11.5"><Run Text="Accessed: " Foreground="{StaticResource TextMuted}" FontFamily="Segoe UI"/><Run Text="{Binding SelectedRecord.OriginalLastAccessed, StringFormat=u}"/></TextBlock>
                        </StackPanel>
                    </ScrollViewer>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="12,10" Background="{StaticResource BgRowAlt}">
                        <StackPanel>
                            <TextBlock Text="REPLACEMENT FILE" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,8"/>
                            <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="Name: " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding SelectedRecord.ReplacementFileName}"/></TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,2" FontFamily="Consolas" FontSize="11.5"><Run Text="Path: " Foreground="{StaticResource TextMuted}" FontFamily="Segoe UI"/><Run Text="{Binding SelectedRecord.ReplacementPath}"/></TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,2" FontFamily="Consolas" FontSize="11.5"><Run Text="SHA256: " Foreground="{StaticResource TextMuted}" FontFamily="Segoe UI"/><Run Text="{Binding SelectedRecord.ReplacementHash}"/></TextBlock>
                            <TextBlock Margin="0,2"><Run Text="Trust: " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding SelectedRecord.ReplacementTrust}"/></TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="Signer: " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding SelectedRecord.ReplacementSigner}"/></TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,2"><Run Text="Format: " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding SelectedRecord.DetectedFormat}"/></TextBlock>

                            <TextBlock Margin="0,10,0,4" Text="SIGNATURE" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            <TextBlock Margin="0,2"><Run Text="Verdict: " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding SelectedRecord.SignatureVerdict}"/></TextBlock>
                            <Border Background="#1F2125" BorderBrush="{StaticResource Border1}" BorderThickness="1" Margin="0,6,0,0" Padding="8,6">
                                <TextBlock Text="{Binding SelectedRecord.SignatureDetails}" TextWrapping="Wrap"
                                           FontFamily="Consolas" FontSize="11" Foreground="{StaticResource TextPrimary}"/>
                            </Border>

                            <TextBlock Margin="0,10,0,4" Text="YARA MATCHES" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                            <ItemsControl ItemsSource="{Binding SelectedRecord.YaraMatches}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="#E06C75"
                                                   FontFamily="Consolas" FontSize="11" Margin="0,1"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Column="2" Background="{StaticResource BgRow}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="USN TIMELINE" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="12,10,12,6"/>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedEvidence}" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0" RowHeight="20"
                                      RowBackground="{StaticResource BgRow}" AlternatingRowBackground="{StaticResource BgRowAlt}"
                                      Foreground="{StaticResource TextPrimary}" GridLinesVisibility="None"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                      CanUserResizeColumns="True" CanUserSortColumns="True"
                                      materialDesign:DataGridAssist.CellPadding="8,2"
                                      materialDesign:DataGridAssist.ColumnHeaderPadding="8,4">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="When" Binding="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="155">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Reason / Pattern" Binding="{Binding Description}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,2"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Raw" Binding="{Binding RawData}" Width="220">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11"/><Setter Property="Opacity" Value="0.8"/></Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="6" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource Border1}" BorderThickness="0,1,0,0" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11.5"/>
                <ProgressBar Grid.Column="1" Value="{Binding ProgressValue}" Maximum="100"
                             Width="180" Height="6" Margin="16,0,0,0"
                             Foreground="#7EC07E" Background="#1F2125"
                             Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Grid.Column="2" Text="{Binding UpdateStatusText}" Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" FontSize="11.5"/>
            </Grid>
        </Border>
        </Grid>

        <!-- ===== STARRY ANALYSIS OVERLAY ===== -->
        <Grid Background="#0E1014" Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
            <!-- Static star field, scattered points -->
            <Canvas>
                <Ellipse Canvas.Left="120"  Canvas.Top="40"  Width="2" Height="2" Fill="#B8C5D6" Opacity="0.8"/>
                <Ellipse Canvas.Left="280"  Canvas.Top="90"  Width="2" Height="2" Fill="#A8B5C6" Opacity="0.6"/>
                <Ellipse Canvas.Left="450"  Canvas.Top="55"  Width="3" Height="3" Fill="#C8D5E6" Opacity="0.9"/>
                <Ellipse Canvas.Left="620"  Canvas.Top="110" Width="2" Height="2" Fill="#98A5B6" Opacity="0.5"/>
                <Ellipse Canvas.Left="780"  Canvas.Top="35"  Width="2" Height="2" Fill="#B8C5D6" Opacity="0.7"/>
                <Ellipse Canvas.Left="940"  Canvas.Top="80"  Width="2" Height="2" Fill="#A8B5C6" Opacity="0.6"/>
                <Ellipse Canvas.Left="1100" Canvas.Top="50"  Width="3" Height="3" Fill="#C8D5E6" Opacity="0.9"/>
                <Ellipse Canvas.Left="1260" Canvas.Top="95"  Width="2" Height="2" Fill="#B8C5D6" Opacity="0.7"/>
                <Ellipse Canvas.Left="1420" Canvas.Top="60"  Width="2" Height="2" Fill="#98A5B6" Opacity="0.5"/>

                <Ellipse Canvas.Left="60"   Canvas.Top="180" Width="2" Height="2" Fill="#A8B5C6" Opacity="0.6"/>
                <Ellipse Canvas.Left="210"  Canvas.Top="220" Width="2" Height="2" Fill="#B8C5D6" Opacity="0.8"/>
                <Ellipse Canvas.Left="380"  Canvas.Top="160" Width="3" Height="3" Fill="#C8D5E6" Opacity="0.9"/>
                <Ellipse Canvas.Left="540"  Canvas.Top="245" Width="2" Height="2" Fill="#98A5B6" Opacity="0.5"/>
                <Ellipse Canvas.Left="710"  Canvas.Top="200" Width="2" Height="2" Fill="#B8C5D6" Opacity="0.7"/>
                <Ellipse Canvas.Left="880"  Canvas.Top="170" Width="2" Height="2" Fill="#A8B5C6" Opacity="0.6"/>
                <Ellipse Canvas.Left="1050" Canvas.Top="230" Width="2" Height="2" Fill="#B8C5D6" Opacity="0.7"/>
                <Ellipse Canvas.Left="1220" Canvas.Top="190" Width="3" Height="3" Fill="#C8D5E6" Opacity="0.9"/>
                <Ellipse Canvas.Left="1380" Canvas.Top="155" Width="2" Height="2" Fill="#98A5B6" Opacity="0.5"/>

                <Ellipse Canvas.Left="100"  Canvas.Top="320" Width="2" Height="2" Fill="#B8C5D6" Opacity="0.8"/>
                <Ellipse Canvas.Left="250"  Canvas.Top="380" Width="2" Height="2" Fill="#A8B5C6" Opacity="0.6"/>
                <Ellipse Canvas.Left="420"  Canvas.Top="340" Width="2" Height="2" Fill="#98A5B6" Opacity="0.5"/>
                <Ellipse Canvas.Left="580"  Canvas.Top="410" Width="3" Height="3" Fill="#C8D5E6" Opacity="0.9"/>
                <Ellipse Canvas.Left="750"  Canvas.Top="350" Width="2" Height="2" Fill="#B8C5D6" Opacity="0.7"/>
                <Ellipse Canvas.Left="920"  Canvas.Top="390" Width="2" Height="2" Fill="#A8B5C6" Opacity="0.6"/>
                <Ellipse Canvas.Left="1080" Canvas.Top="320" Width="2" Height="2" Fill="#98A5B6" Opacity="0.5"/>
                <Ellipse Canvas.Left="1260" Canvas.Top="380" Width="2" Height="2" Fill="#B8C5D6" Opacity="0.8"/>
                <Ellipse Canvas.Left="1430" Canvas.Top="340" Width="2" Height="2" Fill="#A8B5C6" Opacity="0.6"/>

                <Ellipse Canvas.Left="80"   Canvas.Top="490" Width="3" Height="3" Fill="#C8D5E6" Opacity="0.9"/>
                <Ellipse Canvas.Left="230"  Canvas.Top="540" Width="2" Height="2" Fill="#B8C5D6" Opacity="0.7"/>
                <Ellipse Canvas.Left="400"  Canvas.Top="510" Width="2" Height="2" Fill="#98A5B6" Opacity="0.5"/>
                <Ellipse Canvas.Left="560"  Canvas.Top="570" Width="2" Height="2" Fill="#A8B5C6" Opacity="0.6"/>
                <Ellipse Canvas.Left="730"  Canvas.Top="520" Width="2" Height="2" Fill="#B8C5D6" Opacity="0.7"/>
                <Ellipse Canvas.Left="900"  Canvas.Top="560" Width="3" Height="3" Fill="#C8D5E6" Opacity="0.9"/>
                <Ellipse Canvas.Left="1070" Canvas.Top="500" Width="2" Height="2" Fill="#98A5B6" Opacity="0.5"/>
                <Ellipse Canvas.Left="1240" Canvas.Top="550" Width="2" Height="2" Fill="#B8C5D6" Opacity="0.8"/>
                <Ellipse Canvas.Left="1400" Canvas.Top="490" Width="2" Height="2" Fill="#A8B5C6" Opacity="0.6"/>

                <Ellipse Canvas.Left="150"  Canvas.Top="660" Width="2" Height="2" Fill="#B8C5D6" Opacity="0.7"/>
                <Ellipse Canvas.Left="310"  Canvas.Top="700" Width="2" Height="2" Fill="#A8B5C6" Opacity="0.6"/>
                <Ellipse Canvas.Left="470"  Canvas.Top="650" Width="3" Height="3" Fill="#C8D5E6" Opacity="0.9"/>
                <Ellipse Canvas.Left="640"  Canvas.Top="720" Width="2" Height="2" Fill="#98A5B6" Opacity="0.5"/>
                <Ellipse Canvas.Left="810"  Canvas.Top="680" Width="2" Height="2" Fill="#B8C5D6" Opacity="0.7"/>
                <Ellipse Canvas.Left="970"  Canvas.Top="640" Width="2" Height="2" Fill="#A8B5C6" Opacity="0.6"/>
                <Ellipse Canvas.Left="1140" Canvas.Top="710" Width="2" Height="2" Fill="#B8C5D6" Opacity="0.8"/>
                <Ellipse Canvas.Left="1300" Canvas.Top="670" Width="3" Height="3" Fill="#C8D5E6" Opacity="0.9"/>
                <Ellipse Canvas.Left="1460" Canvas.Top="720" Width="2" Height="2" Fill="#98A5B6" Opacity="0.5"/>

                <Ellipse Canvas.Left="200"  Canvas.Top="800" Width="2" Height="2" Fill="#B8C5D6" Opacity="0.7"/>
                <Ellipse Canvas.Left="360"  Canvas.Top="840" Width="2" Height="2" Fill="#A8B5C6" Opacity="0.6"/>
                <Ellipse Canvas.Left="520"  Canvas.Top="790" Width="2" Height="2" Fill="#98A5B6" Opacity="0.5"/>
                <Ellipse Canvas.Left="700"  Canvas.Top="850" Width="3" Height="3" Fill="#C8D5E6" Opacity="0.9"/>
                <Ellipse Canvas.Left="860"  Canvas.Top="810" Width="2" Height="2" Fill="#B8C5D6" Opacity="0.7"/>
                <Ellipse Canvas.Left="1030" Canvas.Top="780" Width="2" Height="2" Fill="#A8B5C6" Opacity="0.6"/>
                <Ellipse Canvas.Left="1190" Canvas.Top="830" Width="2" Height="2" Fill="#B8C5D6" Opacity="0.8"/>
                <Ellipse Canvas.Left="1360" Canvas.Top="800" Width="2" Height="2" Fill="#98A5B6" Opacity="0.5"/>
            </Canvas>

            <!-- Central spinner + label -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="80" Height="80" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Ellipse Stroke="#3D4147" StrokeThickness="3"/>
                    <Path x:Name="Spinner" Stroke="#5FA8D3" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 40 4 A 36 36 0 1 1 4 40" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="Spinner"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:1.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>
                </Grid>
                <TextBlock Text="{Binding StatusText}" Foreground="#8FA5BD" FontSize="15"
                           HorizontalAlignment="Center" FontFamily="Segoe UI"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
