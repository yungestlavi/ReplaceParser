<Window x:Class="SSForensic.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SSForensic.ViewModels"
        Title="Replace Parser"
        Icon="/app.ico"
        Height="900" Width="1500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBase}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                    <DoubleAnimation Storyboard.TargetName="Cloud1T" Storyboard.TargetProperty="X"
                                     From="-700" To="1700" Duration="0:2:40"/>
                    <DoubleAnimation Storyboard.TargetName="Cloud2T" Storyboard.TargetProperty="X"
                                     From="-900" To="1700" Duration="0:2:00"/>
                    <DoubleAnimation Storyboard.TargetName="Cloud3T" Storyboard.TargetProperty="X"
                                     From="-800" To="1700" Duration="0:1:30"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Grid>
        <!-- Subtle ambient cloud background, very desaturated -->
        <Grid>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0E0E12" Offset="0"/>
                    <GradientStop Color="#13131A" Offset="0.5"/>
                    <GradientStop Color="#0B0B10" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Canvas Opacity="0.10">
                <Canvas.RenderTransform><TranslateTransform x:Name="Cloud1T" X="0"/></Canvas.RenderTransform>
                <Ellipse Canvas.Left="0" Canvas.Top="120" Width="380" Height="150" Fill="#7080A0">
                    <Ellipse.Effect><BlurEffect Radius="60"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Canvas.Left="500" Canvas.Top="80" Width="460" Height="170" Fill="#6878A0">
                    <Ellipse.Effect><BlurEffect Radius="60"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Canvas.Left="1050" Canvas.Top="150" Width="400" Height="160" Fill="#7080A0">
                    <Ellipse.Effect><BlurEffect Radius="60"/></Ellipse.Effect>
                </Ellipse>
            </Canvas>

            <Canvas Opacity="0.08">
                <Canvas.RenderTransform><TranslateTransform x:Name="Cloud2T" X="0"/></Canvas.RenderTransform>
                <Ellipse Canvas.Left="0" Canvas.Top="430" Width="500" Height="200" Fill="#606A88">
                    <Ellipse.Effect><BlurEffect Radius="65"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Canvas.Left="650" Canvas.Top="500" Width="560" Height="220" Fill="#5A6480">
                    <Ellipse.Effect><BlurEffect Radius="65"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Canvas.Left="1150" Canvas.Top="450" Width="500" Height="210" Fill="#606A88">
                    <Ellipse.Effect><BlurEffect Radius="65"/></Ellipse.Effect>
                </Ellipse>
            </Canvas>

            <Canvas Opacity="0.06">
                <Canvas.RenderTransform><TranslateTransform x:Name="Cloud3T" X="0"/></Canvas.RenderTransform>
                <Ellipse Canvas.Left="0" Canvas.Top="800" Width="460" Height="180" Fill="#5A6480">
                    <Ellipse.Effect><BlurEffect Radius="60"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse Canvas.Left="700" Canvas.Top="820" Width="520" Height="200" Fill="#5A6480">
                    <Ellipse.Effect><BlurEffect Radius="60"/></Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Grid>

        <!-- ====== UI ====== -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- Title bar -->
                <RowDefinition Height="Auto"/>   <!-- Toolbar -->
                <RowDefinition Height="Auto"/>   <!-- Extensions -->
                <RowDefinition Height="Auto"/>   <!-- Filters -->
                <RowDefinition Height="Auto"/>   <!-- Search -->
                <RowDefinition Height="*" MinHeight="200"/>  <!-- Grid -->
                <RowDefinition Height="4"/>      <!-- Splitter -->
                <RowDefinition Height="320" MinHeight="100"/> <!-- Details -->
                <RowDefinition Height="Auto"/>   <!-- Statusbar -->
            </Grid.RowDefinitions>

            <!-- Title bar: a thin app header, not a hero banner -->
            <Border Grid.Row="0" Background="#101015" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1" Padding="16,10">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="Replace Parser" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
                        <TextBlock Text="by yungestlavi" Foreground="{StaticResource TextMuted}" FontSize="11"
                                   VerticalAlignment="Bottom" Margin="10,0,0,3"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Style="{StaticResource FlatButton}" Command="{Binding CheckUpdatesCommand}"
                                IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InvertBooleanConverter}}"
                                Content="check updates" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource FlatButton}" Command="{Binding OpenServicesCommand}"
                                Content="services"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Toolbar: drive, boot info, run, cancel -->
            <Border Grid.Row="1" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1" Padding="16,10">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="DRIVE" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox Width="42" Text="{Binding DriveLetter, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" HorizontalContentAlignment="Center"
                                 FontFamily="Cascadia Mono, Consolas, monospace"/>
                        <TextBlock Text="{Binding LastBootInfo}" Style="{StaticResource LabelText}"
                                   Margin="20,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button Style="{StaticResource FlatButton}" Command="{Binding CancelCommand}"
                                IsEnabled="{Binding IsAnalyzing}" Content="cancel" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding RunAnalysisCommand}"
                                IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InvertBooleanConverter}}"
                                Content="▶  RUN ANALYSIS"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Extensions row -->
            <Border Grid.Row="2" Background="{StaticResource BgPanelAlt}" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1" Padding="16,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="EXTENSIONS" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <ItemsControl ItemsSource="{Binding Extensions}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Extension}" IsChecked="{Binding IsEnabled}" Margin="0,0,14,0"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Width="1" Background="{StaticResource Border1}" Margin="6,3,12,3"/>
                    <CheckBox IsChecked="{Binding DetectSuspiciousExt}" VerticalAlignment="Center"
                              Foreground="{StaticResource TextSecondary}">
                        <CheckBox.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="modified-ext detection" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Text=" (noisy)" Foreground="{StaticResource TextMuted}" FontStyle="Italic"/>
                            </StackPanel>
                        </CheckBox.Content>
                    </CheckBox>
                </StackPanel>
            </Border>

            <!-- Filter row -->
            <Border Grid.Row="3" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1" Padding="16,4">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource FilterChip}" Command="{Binding SetFilterCommand}" CommandParameter="ALL">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="all "/><TextBlock Text="{Binding TotalRecords}" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FilterChip}" Command="{Binding SetFilterCommand}" CommandParameter="RENAMES">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="renames "/><TextBlock Text="{Binding RenameReplaces}" Foreground="#E06C75"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FilterChip}" Command="{Binding SetFilterCommand}" CommandParameter="CHEATS">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="cheats "/><TextBlock Text="{Binding CheatHits}" Foreground="#61AFEF"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FilterChip}" Command="{Binding SetFilterCommand}" CommandParameter="UNSIGNED">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="unsigned "/><TextBlock Text="{Binding UnsignedHits}" Foreground="#D19A66"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FilterChip}" Command="{Binding SetFilterCommand}" CommandParameter="LEGIT">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="legit "/><TextBlock Text="{Binding LegitHits}" Foreground="#98C379"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource FilterChip}" Command="{Binding SetFilterCommand}" CommandParameter="SPOOFED">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="spoofed "/><TextBlock Text="{Binding SpoofedHits}" Foreground="#C678DD"/>
                        </StackPanel>
                    </Button>
                    <TextBlock VerticalAlignment="Center" Margin="16,0,0,0" Style="{StaticResource LabelText}">
                        <Run Text="active: "/><Run Text="{Binding ActiveFilter}" Foreground="{StaticResource Accent}"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Search row -->
            <Border Grid.Row="4" Background="{StaticResource BgPanelAlt}" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1" Padding="16,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="FILTER" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Style="{StaticResource FlatButton}" Command="{Binding ClearSearchCommand}"
                            Content="✕" Margin="6,0,0,0" Padding="10,5"/>
                </Grid>
            </Border>

            <!-- Main grid -->
            <DataGrid Grid.Row="5" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}"
                      AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="trust" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                             Fill="{Binding ReplacementTrust, Converter={StaticResource TrustToBrush}}"/>
                                    <TextBlock Text="{Binding ReplacementTrust}" FontSize="11"
                                               Foreground="#C0C0CC"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="file" Binding="{Binding ReplacementFileName}" Width="220"/>
                    <DataGridTextColumn Header="original path" Binding="{Binding OriginalPath}" Width="*"/>
                    <DataGridTextColumn Header="replacement path" Binding="{Binding ReplacementPath}" Width="*"/>
                    <DataGridTextColumn Header="replaced (utc)" Binding="{Binding ReplaceTimestamp, StringFormat=u}" Width="155">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/></Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="ext" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DeclaredExtension}" FontFamily="Cascadia Mono, Consolas, monospace"/>
                                    <TextBlock Text="→" Foreground="{StaticResource TextMuted}" Margin="4,0,4,0"
                                               Visibility="{Binding ExtensionSpoofed, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding DetectedFormat}" Foreground="#C678DD" FontFamily="Cascadia Mono, Consolas, monospace"
                                               Visibility="{Binding ExtensionSpoofed, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="6" Height="4" HorizontalAlignment="Stretch" Background="{StaticResource Border1}"
                          ResizeBehavior="PreviousAndNext" Cursor="SizeNS" ShowsPreview="True"/>

            <!-- Detail panel: three compact cards -->
            <Border Grid.Row="7" Background="{StaticResource BgPanel}" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Left" Text="DETAIL" Style="{StaticResource LabelText}"/>
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextMuted}" FontSize="11"
                                   Text="{Binding SelectedRecord.ReplacementFileName, StringFormat='selected: {0}'}"/>
                    </DockPanel>
                    <Grid Grid.Row="1" Visibility="{Binding SelectedRecord, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="240"/>
                            <ColumnDefinition Width="*" MinWidth="280"/>
                            <ColumnDefinition Width="2*" MinWidth="320"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BgPanelAlt}" BorderBrush="{StaticResource Border1}" BorderThickness="1" Margin="0,0,8,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="ORIGINAL FILE" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2" Foreground="{StaticResource TextPrimary}">
                                        <Run Text="name " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding SelectedRecord.OriginalFileName}"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11">
                                        <Run Text="path " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding SelectedRecord.OriginalPath}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,2">
                                        <Run Text="trust " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding SelectedRecord.OriginalTrust}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,2" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11">
                                        <Run Text="created  " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding SelectedRecord.OriginalCreated, StringFormat=u}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,2" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11">
                                        <Run Text="modified " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding SelectedRecord.OriginalLastModified, StringFormat=u}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,2" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11">
                                        <Run Text="accessed " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding SelectedRecord.OriginalLastAccessed, StringFormat=u}"/>
                                    </TextBlock>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Background="{StaticResource BgPanelAlt}" BorderBrush="{StaticResource Border1}" BorderThickness="1" Margin="0,0,8,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="REPLACEMENT FILE" Style="{StaticResource LabelText}" Margin="0,0,0,8"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2">
                                        <Run Text="name " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding SelectedRecord.ReplacementFileName}"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11">
                                        <Run Text="path " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding SelectedRecord.ReplacementPath}"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11">
                                        <Run Text="sha256 " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding SelectedRecord.ReplacementHash}"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,2">
                                        <Run Text="trust " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding SelectedRecord.ReplacementTrust}"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2">
                                        <Run Text="signer " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding SelectedRecord.ReplacementSigner}"/>
                                    </TextBlock>
                                    <TextBlock TextWrapping="Wrap" Margin="0,2">
                                        <Run Text="format " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding SelectedRecord.DetectedFormat}"/>
                                    </TextBlock>

                                    <TextBlock Margin="0,10,0,4" Text="SIGNATURE" Style="{StaticResource LabelText}"/>
                                    <TextBlock Margin="0,2">
                                        <Run Text="verdict " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding SelectedRecord.SignatureVerdict}" Foreground="{StaticResource Accent}"/>
                                    </TextBlock>
                                    <Border Background="#0A0A10" BorderBrush="{StaticResource Border1}" BorderThickness="1" Margin="0,6,0,0" Padding="8,6">
                                        <TextBlock Text="{Binding SelectedRecord.SignatureDetails}" TextWrapping="Wrap"
                                                   FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11"
                                                   Foreground="#B8B8C4"/>
                                    </Border>

                                    <TextBlock Margin="0,10,0,4" Text="YARA MATCHES" Style="{StaticResource LabelText}"/>
                                    <ItemsControl ItemsSource="{Binding SelectedRecord.YaraMatches}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#E06C75"
                                                           FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" Margin="0,1"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource BgPanelAlt}" BorderBrush="{StaticResource Border1}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="USN TIMELINE" Style="{StaticResource LabelText}" Margin="12,10,12,6"/>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedEvidence}" AutoGenerateColumns="False" IsReadOnly="True"
                                          BorderThickness="0" Background="Transparent" RowHeight="22"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                          CanUserResizeColumns="True" CanUserSortColumns="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="when (utc)" Binding="{Binding Timestamp, StringFormat=u}" Width="160">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/><Setter Property="FontSize" Value="11"/></Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="reason / pattern" Binding="{Binding Description}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,3"/></Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="raw" Binding="{Binding RawData}" Width="220">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/><Setter Property="FontSize" Value="11"/><Setter Property="Opacity" Value="0.8"/></Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- Status bar -->
            <Border Grid.Row="8" Background="#0A0A10" BorderBrush="{StaticResource Border1}" BorderThickness="0,1,0,0" Padding="14,5">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" Style="{StaticResource LabelText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="1" Text="{Binding UpdateStatusText}" Style="{StaticResource LabelText}"
                               VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ====== ANALYZING OVERLAY (sober, dev-tool style) ====== -->
        <Grid Background="#CC0A0A10"
              Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#15151A" BorderBrush="{StaticResource Border2}" BorderThickness="1"
                    Padding="40,30" Width="480">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Accent}" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.3" To="1.0" Duration="0:0:0.8" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock Text="ANALYZING" Foreground="{StaticResource Accent}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   Text="{Binding ProgressValue, StringFormat={}{0:00}%}"
                                   Foreground="{StaticResource TextPrimary}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="13" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="3"/>

                    <Border Background="#0A0A10" BorderBrush="{StaticResource Border1}" BorderThickness="1" Margin="0,16,0,0" Padding="10,8">
                        <TextBlock Text="{Binding StatusText}" Foreground="#B8B8C4"
                                   FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11"
                                   TextWrapping="Wrap" MinHeight="34"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
