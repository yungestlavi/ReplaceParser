<Window x:Class="SSForensic.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:SSForensic.ViewModels"
        xmlns:local="clr-namespace:SSForensic.Views"
        Title="Replace Parser"
        Icon="/app.ico"
        Height="900" Width="1500"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource BgBase}"
        TextElement.Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI"
        FontSize="12">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:ReplaceTypeToBrushConverter       x:Key="ReplaceTypeToBrush"/>
        <local:ReplaceTypeToDescriptionConverter x:Key="ReplaceTypeToDescription"/>
        <local:TrustToBadgeBrushConverter        x:Key="TrustToBadgeBrush"/>
        <local:ReplaceTypeToBadgeBrushConverter  x:Key="ReplaceTypeToBadgeBrush"/>
        <local:RomeTimestampConverter             x:Key="RomeTimestamp"/>

        <!-- Neon ContextMenu style -->
        <Style x:Key="NeonContextMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#0F0A1A"/>
            <Setter Property="BorderBrush" Value="#3D2060"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0,4"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#9040FF" BlurRadius="18" ShadowDepth="0" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neon MenuItem style -->
        <Style x:Key="NeonMenuItem" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#D0D0E8"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="16,7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="b" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#1E1030"/>
                                <Setter Property="Foreground" Value="#C084FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Neon Separator style -->
        <Style x:Key="NeonSeparator" TargetType="Separator">
            <Setter Property="Background" Value="#2A1848"/>
            <Setter Property="Margin" Value="8,3"/>
            <Setter Property="Height" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>     <!-- Custom titlebar -->
                <RowDefinition Height="Auto"/>   <!-- Top toolbar: search + checkboxes + buttons -->
                <RowDefinition Height="Auto"/>   <!-- Drive + extensions row -->
                <RowDefinition Height="Auto"/>   <!-- Filter chips -->
                <RowDefinition Height="*" MinHeight="200"/>   <!-- Main grid -->
                <RowDefinition Height="4"/>      <!-- Splitter -->
                <RowDefinition Height="280" MinHeight="100"/> <!-- Details -->
                <RowDefinition Height="Auto"/>   <!-- Status bar -->
            </Grid.RowDefinitions>

            <!-- ===== CUSTOM TITLEBAR ===== -->
            <Border Grid.Row="0" x:Name="TitleBar"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#05050A" Offset="0"/>
                        <GradientStop Color="#0A0515" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App icon + neon title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Image Source="/app.ico" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <!-- "ReplaceParser" in neon violet -->
                        <TextBlock Text="ReplaceParser" VerticalAlignment="Center"
                                   FontFamily="Segoe UI Black, Segoe UI Bold" FontSize="14" FontWeight="Black">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#C864FF" Offset="0"/>
                                    <GradientStop Color="#F080FF" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#C050FF" BlurRadius="14" ShadowDepth="0" Opacity="0.85"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <!-- " made by Lavi" in muted white -->
                        <TextBlock Text=" made by Lavi" VerticalAlignment="Center"
                                   FontFamily="Segoe UI" FontSize="12" FontWeight="Normal"
                                   Foreground="#8080A0"/>
                    </StackPanel>

                    <!-- Window controls: minimize / maximize / close -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch">
                        <Button Click="MinimizeBtn_Click" Width="46" Height="38"
                                Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TextSecondary}"
                                FontFamily="Marlett" FontSize="10" Content="0"
                                ToolTip="Minimizza">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#1A1A2A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="MaximizeBtn_Click" Width="46" Height="38"
                                Foreground="{StaticResource TextSecondary}"
                                FontFamily="Marlett" FontSize="10" Content="1"
                                ToolTip="Massimizza">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#1A1A2A"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Click="CloseBtn_Click" Width="46" Height="38"
                                Foreground="{StaticResource TextSecondary}"
                                FontFamily="Marlett" FontSize="10" Content="r"
                                ToolTip="Chiudi">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="b" Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="b" Property="Background" Value="#8B0000"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

        <!-- ===== TOP TOOLBAR: neon title + search + action buttons ===== -->
        <Border Grid.Row="1" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1" Padding="14,10">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#07070A" Offset="0"/>
                    <GradientStop Color="#0F0A18" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="#0D0A18" Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource Border2}" BorderThickness="1"
                         Padding="10,6" VerticalAlignment="Center"
                         FontFamily="Segoe UI" Tag="Search..."/>

                <!-- Modified Extensions checkbox -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding DetectSuspiciousExt}" Foreground="{StaticResource TextSecondary}" Margin="0,0,20,0">
                        <TextBlock Text="Modified Extensions"/>
                    </CheckBox>
                </StackPanel>

                <!-- Action buttons (neon oval) -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding RunAnalysisCommand}"
                            IsEnabled="{Binding IsAnalyzing, Converter={StaticResource InvertBooleanConverter}}"
                            Style="{StaticResource NeonButton}" Margin="0,0,8,0" Content="Parse again"/>
                    <Button Command="{Binding CancelCommand}"
                            IsEnabled="{Binding IsAnalyzing}"
                            Style="{StaticResource NeonButton}" Margin="0,0,8,0" Content="Cancel"/>
                    <Button Command="{Binding OpenServicesCommand}"
                            Style="{StaticResource NeonButton}" Margin="0,0,8,0" Content="Services"/>
                    <Button Command="{Binding CheckUpdatesCommand}"
                            IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InvertBooleanConverter}}"
                            Style="{StaticResource NeonButton}" Content="Check Updates"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== DRIVE + EXTENSIONS ROW ===== -->
        <Border Grid.Row="2" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1" Padding="10,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Drive:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBox Width="42" Text="{Binding DriveLetter, UpdateSourceTrigger=PropertyChanged}"
                         Background="#1F2125" Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource Border1}" BorderThickness="1"
                         Padding="6,3" HorizontalContentAlignment="Center"
                         FontFamily="Consolas" VerticalAlignment="Center"/>
                <Rectangle Width="1" Fill="{StaticResource Border1}" Margin="14,2,14,2"/>
                <TextBlock Text="Extensions:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ItemsControl ItemsSource="{Binding Extensions}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Extension}" IsChecked="{Binding IsEnabled}"
                                      Foreground="{StaticResource TextPrimary}" Margin="0,0,12,0"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Rectangle Width="1" Fill="{StaticResource Border1}" Margin="14,2,14,2"/>
                <TextBlock Text="{Binding LastBootInfo}" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"
                           FontFamily="Consolas"/>
            </StackPanel>
        </Border>

        <!-- ===== FILTER CHIPS ===== -->
        <Border Grid.Row="3" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1" Padding="10,4">
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding SetFilterCommand}" CommandParameter="ALL"
                        Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                        Padding="8,4" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="All "/>
                        <TextBlock Text="{Binding TotalRecords}" Foreground="{StaticResource TextSecondary}"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetFilterCommand}" CommandParameter="RENAMES"
                        Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                        Padding="8,4" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Renames "/>
                        <TextBlock Text="{Binding RenameReplaces}" Foreground="#E06C75"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetFilterCommand}" CommandParameter="CHEATS"
                        Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                        Padding="8,4" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Cheats "/>
                        <TextBlock Text="{Binding CheatHits}" Foreground="#61AFEF"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetFilterCommand}" CommandParameter="UNSIGNED"
                        Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                        Padding="8,4" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Unsigned "/>
                        <TextBlock Text="{Binding UnsignedHits}" Foreground="#E06C75"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetFilterCommand}" CommandParameter="LEGIT"
                        Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                        Padding="8,4" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Legit "/>
                        <TextBlock Text="{Binding LegitHits}" Foreground="#7EC07E"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding SetFilterCommand}" CommandParameter="SPOOFED"
                        Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                        Padding="8,4" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Spoofed "/>
                        <TextBlock Text="{Binding SpoofedHits}" Foreground="#C678DD"/>
                    </StackPanel>
                </Button>
                <Rectangle Width="1" Fill="{StaticResource Border1}" Margin="12,4,12,4"/>
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextMuted}">
                    <Run Text="Active: "/><Run Text="{Binding ActiveFilter}" Foreground="{StaticResource TextPrimary}"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- ===== MAIN GRID ===== -->
        <DataGrid Grid.Row="4" ItemsSource="{Binding Records}" SelectedItem="{Binding SelectedRecord}"
                  MouseDoubleClick="RecordsGrid_MouseDoubleClick"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  Background="{StaticResource BgBase}" Foreground="{StaticResource TextPrimary}"
                  RowBackground="{StaticResource BgRow}" AlternatingRowBackground="{StaticResource BgRowAlt}"
                  BorderThickness="0" GridLinesVisibility="None" RowHeight="22"
                  HorizontalGridLinesBrush="#3D4147"
                  materialDesign:DataGridAssist.CellPadding="8,2"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8,4">
            <DataGrid.ContextMenu>
                <ContextMenu Style="{StaticResource NeonContextMenu}">
                    <MenuItem Header="📋  Copy Original Path"  Click="CopyOriginalPath_Click"
                              Style="{StaticResource NeonMenuItem}"/>
                    <MenuItem Header="📋  Copy Replacement Path" Click="CopyReplacementPath_Click"
                              Style="{StaticResource NeonMenuItem}"/>
                    <Separator Style="{StaticResource NeonSeparator}"/>
                    <MenuItem Header="📋  Copy File Name" Click="CopyFileName_Click"
                              Style="{StaticResource NeonMenuItem}"/>
                    <MenuItem Header="📋  Copy Row (TSV)" Click="CopyRowTsv_Click"
                              Style="{StaticResource NeonMenuItem}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Replace Time (IT)" Binding="{Binding ReplaceTimestamp, Converter={StaticResource RomeTimestamp}}" Width="175">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="11.5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="File" Binding="{Binding ReplacementFileName}" Width="200"/>
                <DataGridTextColumn Header="Original Path" Binding="{Binding OriginalPath}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="11.5"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Replacement Path" Binding="{Binding ReplacementPath}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="11.5"/>
                            <Setter Property="Foreground" Value="#E06C75"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Ext" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DeclaredExtension}" FontFamily="Consolas" FontSize="11.5"/>
                                <TextBlock Text=" → " Foreground="{StaticResource TextMuted}"
                                           Visibility="{Binding ExtensionSpoofed, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding DetectedFormat}" Foreground="#C678DD" FontFamily="Consolas" FontSize="11.5"
                                           Visibility="{Binding ExtensionSpoofed, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Signature" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ReplacementTrust}"
                                       Foreground="{Binding ReplacementTrust, Converter={StaticResource TrustToBrush}}"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Type" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding ReplaceTypeLabel}"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas" FontSize="11.5"
                                       Foreground="{Binding DetectedReplaceType, Converter={StaticResource ReplaceTypeToBrush}}">
                                <TextBlock.ToolTip>
                                    <ToolTip>
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" Text="{Binding ReplaceTypeLabel, StringFormat='Replace type: {0}'}"/>
                                            <TextBlock Margin="0,4,0,0" Text="{Binding DetectedReplaceType, Converter={StaticResource ReplaceTypeToDescription}}" TextWrapping="Wrap" MaxWidth="280"/>
                                        </StackPanel>
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="5" Height="4" HorizontalAlignment="Stretch" Background="{StaticResource Border1}"
                      ResizeBehavior="PreviousAndNext" Cursor="SizeNS" ShowsPreview="True"/>

        <!-- ===== DETAILS ===== -->
        <Border Grid.Row="6" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource Border1}" BorderThickness="0,1,0,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1" Padding="16,8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0A0812" Offset="0"/>
                            <GradientStop Color="#0D0D14" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Details" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextMuted}" FontFamily="Consolas" FontSize="11"
                                   VerticalAlignment="Center"
                                   Text="{Binding SelectedRecord.ReplacementFileName, StringFormat='→  {0}'}"/>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="1" Visibility="{Binding SelectedRecord, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                        <ColumnDefinition Width="*" MinWidth="200"/>
                        <ColumnDefinition Width="2*" MinWidth="300"/>
                    </Grid.ColumnDefinitions>

                    <!-- ═══ COL 0 — ORIGINAL FILE ═══ -->
                    <Border Grid.Column="0" Background="{StaticResource BgRow}"
                            BorderBrush="{StaticResource Border1}" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="ORIGINAL FILE" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,12"/>

                                <TextBlock Text="Name" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedRecord.OriginalFileName}"
                                           FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock Text="Path" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedRecord.OriginalPath}"
                                           FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                           Foreground="#B0B0C8" Margin="0,0,0,12"/>

                                <TextBlock Text="Trust" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,14"
                                        Background="{Binding SelectedRecord.OriginalTrust, Converter={StaticResource TrustToBadgeBrush}}">
                                    <TextBlock Text="{Binding SelectedRecord.OriginalTrust}"
                                               FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                </Border>

                                <Separator Background="{StaticResource Border1}" Margin="0,0,0,12"/>
                                <TextBlock Text="TIMESTAMPS" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>

                                <TextBlock Text="Created" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedRecord.OriginalCreated, StringFormat='{}{0:yyyy-MM-dd  HH:mm:ss}'}"
                                           FontFamily="Consolas" FontSize="11.5" Margin="0,0,0,8"/>

                                <TextBlock Text="Modified" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedRecord.OriginalLastModified, StringFormat='{}{0:yyyy-MM-dd  HH:mm:ss}'}"
                                           FontFamily="Consolas" FontSize="11.5" Margin="0,0,0,8"/>

                                <TextBlock Text="Accessed" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedRecord.OriginalLastAccessed, StringFormat='{}{0:yyyy-MM-dd  HH:mm:ss}'}"
                                           FontFamily="Consolas" FontSize="11.5"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ═══ COL 1 — REPLACEMENT FILE ═══ -->
                    <Border Grid.Column="1" Background="{StaticResource BgRowAlt}"
                            BorderBrush="{StaticResource Border1}" BorderThickness="0,0,1,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="REPLACEMENT FILE" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,12"/>

                                <TextBlock Text="Name" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedRecord.ReplacementFileName}"
                                           FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                <TextBlock Text="Path" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedRecord.ReplacementPath}"
                                           FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                           Foreground="#E08080" Margin="0,0,0,12"/>

                                <!-- Trust + Replace Type badges -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="Trust" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                        <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left"
                                                Background="{Binding SelectedRecord.ReplacementTrust, Converter={StaticResource TrustToBadgeBrush}}">
                                            <TextBlock Text="{Binding SelectedRecord.ReplacementTrust}"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Replace Type" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                        <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Left"
                                                Background="{Binding SelectedRecord.DetectedReplaceType, Converter={StaticResource ReplaceTypeToBadgeBrush}}">
                                            <TextBlock Text="{Binding SelectedRecord.ReplaceTypeLabel}"
                                                       FontSize="11" FontWeight="SemiBold" Foreground="White"
                                                       ToolTip="{Binding SelectedRecord.DetectedReplaceType, Converter={StaticResource ReplaceTypeToDescription}}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Separator Background="{StaticResource Border1}" Margin="0,0,0,12"/>
                                <TextBlock Text="TIMESTAMPS" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMuted}" Margin="0,0,0,8"/>

                                <TextBlock Text="Replace Time" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedRecord.ReplaceTimestamp, Converter={StaticResource RomeTimestamp}}"
                                           FontFamily="Consolas" FontSize="11.5" Foreground="#C084FF" Margin="0,0,0,8"/>

                                <TextBlock Text="Signer" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedRecord.ReplacementSigner}"
                                           FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,8"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ═══ COL 2 — USN TIMELINE ═══ -->
                    <Border Grid.Column="2" Background="{StaticResource BgRow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Padding="16,10" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1">
                                <TextBlock Text="USN TIMELINE" FontSize="9" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMuted}"/>
                            </Border>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedEvidence}"
                                      AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="Transparent" BorderThickness="0"
                                      RowBackground="{StaticResource BgRow}"
                                      AlternatingRowBackground="{StaticResource BgRowAlt}"
                                      Foreground="{StaticResource TextPrimary}"
                                      GridLinesVisibility="Horizontal"
                                      HorizontalGridLinesBrush="#1E1A30"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      CanUserResizeColumns="True"
                                      materialDesign:DataGridAssist.CellPadding="12,6"
                                      materialDesign:DataGridAssist.ColumnHeaderPadding="12,6">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                <Setter Property="FontSize" Value="11.5"/>
                                                <Setter Property="Foreground" Value="#7EC07E"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Reason / Pattern" Binding="{Binding Description}" Width="*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                <Setter Property="FontSize" Value="12"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="Raw" Binding="{Binding RawData}" Width="220">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                <Setter Property="FontSize" Value="10.5"/>
                                                <Setter Property="Foreground" Value="#606080"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="7" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource Border1}" BorderThickness="0,1,0,0" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11.5"/>
                <ProgressBar Grid.Column="1" Value="{Binding ProgressValue}" Maximum="100"
                             Width="180" Height="6" Margin="16,0,0,0"
                             Foreground="#7EC07E" Background="#1F2125"
                             Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVis}}"/>
                <TextBlock Grid.Column="2" Text="{Binding UpdateStatusText}" Foreground="{StaticResource TextMuted}"
                           VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" FontSize="11.5"/>
            </Grid>
        </Border>
