<Window x:Class="SSForensic.Views.ServicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:SSForensic.ViewModels"
        Title="Forensic Services — status"
        Height="860" Width="940"
        WindowStartupLocation="CenterOwner"
        TextElement.Foreground="#FFFFFF"
        FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.DataContext>
        <vm:ServicesViewModel/>
    </Window.DataContext>

    <Grid>
        <!-- Lavender gradient background to match the main window -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#4A3B6E" Offset="0"/>
                <GradientStop Color="#6E5BA0" Offset="0.4"/>
                <GradientStop Color="#9D8BC8" Offset="0.8"/>
                <GradientStop Color="#D4C5EC" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="Forensic Services" FontSize="30" FontWeight="Bold" Foreground="#FFFFFF">
                    <TextBlock.Effect><DropShadowEffect Color="#5B3B8A" BlurRadius="12" ShadowDepth="0"/></TextBlock.Effect>
                </TextBlock>
                <TextBlock Text="Live status of the Windows services that produce execution artefacts."
                           FontStyle="Italic" Foreground="#EDE7F6" Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Summary banner -->
            <Border Grid.Row="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14"
                    Background="#552A1A47">
                <TextBlock Text="{Binding Summary}" FontSize="15" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="#FFFFFF"/>
            </Border>

            <!-- Service list -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Services}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="10" Margin="0,0,0,10" Padding="16,12"
                                    Background="#44331F5E">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Status dot -->
                                    <Ellipse Grid.Column="0" Width="18" Height="18"
                                             VerticalAlignment="Center" Margin="0,0,16,0"
                                             Fill="{Binding HealthColor}">
                                        <Ellipse.Effect><DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="0" Opacity="0.6"/></Ellipse.Effect>
                                    </Ellipse>

                                    <!-- Name + description -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                                            <TextBlock Text="{Binding ShortName}" FontSize="12" Foreground="#D1C4E9" Margin="10,3,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="12.5" Foreground="#E8E0F5"
                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        <TextBlock FontSize="11.5" Foreground="#B39DDB" Margin="0,4,0,0"
                                                   Visibility="{Binding HasExtraInfo, Converter={StaticResource BoolToVis}}"
                                                   TextWrapping="Wrap" Text="{Binding ExtraInfo}"/>
                                    </StackPanel>

                                    <!-- Status text + start type + start time -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                                        <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="Bold"
                                                   HorizontalAlignment="Right" Foreground="{Binding HealthColor}"/>
                                        <TextBlock Text="{Binding StartType}" FontSize="11" Foreground="#CFC2E8"
                                                   HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        <TextBlock FontSize="11" Foreground="#CFC2E8" HorizontalAlignment="Right" Margin="0,2,0,0"
                                                   Text="{Binding StartTimeText, StringFormat=started: {0}}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer: legend + refresh -->
            <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Ellipse Width="13" Height="13" Fill="#43A047" VerticalAlignment="Center"/>
                    <TextBlock Text="Running" Margin="6,0,18,0" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Ellipse Width="13" Height="13" Fill="#FB8C00" VerticalAlignment="Center"/>
                    <TextBlock Text="Paused / pending" Margin="6,0,18,0" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                    <Ellipse Width="13" Height="13" Fill="#E53935" VerticalAlignment="Center"/>
                    <TextBlock Text="Stopped / missing" Margin="6,0,0,0" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>

                <Button DockPanel.Dock="Right" Content="REFRESH" Width="140" Height="40"
                        Command="{Binding RefreshCommand}"
                        Background="#9575CD" BorderBrush="#9575CD" Foreground="#FFFFFF"
                        FontWeight="Bold"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
