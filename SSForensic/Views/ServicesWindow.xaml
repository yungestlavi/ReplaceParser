<Window x:Class="SSForensic.Views.ServicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SSForensic.ViewModels"
        Title="Forensic services"
        Icon="/app.ico"
        Height="780" Width="900"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBase}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI">

    <Window.DataContext>
        <vm:ServicesViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="#101015" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1" Padding="16,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Forensic services" Style="{StaticResource TitleText}"/>
                        <TextBlock Text="live state of windows services that produce execution artefacts"
                                   Style="{StaticResource LabelText}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Summary -->
            <Border Grid.Row="1" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1" Padding="16,10">
                <TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextPrimary}"
                           FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- List -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0">
                <ItemsControl ItemsSource="{Binding Services}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BgPanel}" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1" Padding="16,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Ellipse Grid.Column="0" Width="9" Height="9"
                                             VerticalAlignment="Center" Margin="0,0,14,0"
                                             Fill="{Binding HealthColor}"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                            <TextBlock Text="{Binding ShortName}" FontSize="11" Foreground="{StaticResource TextMuted}"
                                                       FontFamily="Cascadia Mono, Consolas, monospace" Margin="10,2,0,0"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource LabelText}"
                                                   TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource Accent}" Margin="0,4,0,0"
                                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                                   Visibility="{Binding HasExtraInfo, Converter={StaticResource BoolToVis}}"
                                                   TextWrapping="Wrap" Text="{Binding ExtraInfo}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="16,0,0,0">
                                        <TextBlock Text="{Binding StatusText}" FontSize="12.5"
                                                   HorizontalAlignment="Right" Foreground="{Binding HealthColor}"
                                                   FontFamily="Cascadia Mono, Consolas, monospace"/>
                                        <TextBlock Text="{Binding StartType}" FontSize="10.5" Foreground="{StaticResource TextMuted}"
                                                   HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                        <TextBlock FontSize="10.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" Margin="0,2,0,0"
                                                   FontFamily="Cascadia Mono, Consolas, monospace"
                                                   Text="{Binding StartTimeText, StringFormat='since {0}'}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Footer: legend + refresh -->
            <Border Grid.Row="3" Background="#0A0A10" BorderBrush="{StaticResource Border1}" BorderThickness="0,1,0,0" Padding="16,10">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="#98C379" VerticalAlignment="Center"/>
                        <TextBlock Text="running" Margin="6,0,18,0" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                        <Ellipse Width="9" Height="9" Fill="#D19A66" VerticalAlignment="Center"/>
                        <TextBlock Text="paused / pending" Margin="6,0,18,0" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                        <Ellipse Width="9" Height="9" Fill="#E06C75" VerticalAlignment="Center"/>
                        <TextBlock Text="stopped / missing" Margin="6,0,0,0" Style="{StaticResource LabelText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Content="refresh"
                            Command="{Binding RefreshCommand}"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
