<Window x:Class="SSForensic.Views.UsnHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="USN History"
        Icon="/app.ico"
        Height="640" Width="1080"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBase}"
        TextElement.Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI"
        FontSize="12">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Entry information header (mirrors JournalTrace top panel) -->
        <Border Grid.Row="0" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel>
                <TextBlock Text="Entry information" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,8"/>
                <UniformGrid Columns="2">
                    <TextBlock Margin="0,2" FontFamily="Consolas" FontSize="11.5"><Run Text="USN  " Foreground="{StaticResource TextMuted}" FontFamily="Segoe UI"/><Run Text="{Binding HeaderUsn, Mode=OneWay}"/></TextBlock>
                    <TextBlock Margin="0,2"><Run Text="Name  " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding HeaderName, Mode=OneWay}"/></TextBlock>
                    <TextBlock Margin="0,2" FontFamily="Consolas" FontSize="11.5"><Run Text="File Identification  " Foreground="{StaticResource TextMuted}" FontFamily="Segoe UI"/><Run Text="{Binding HeaderFrn, Mode=OneWay}"/></TextBlock>
                    <TextBlock Margin="0,2"><Run Text="Current file  " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding HeaderCurrent, Mode=OneWay}"/></TextBlock>
                    <TextBlock Margin="0,2" FontFamily="Consolas" FontSize="11.5"><Run Text="Directory  " Foreground="{StaticResource TextMuted}" FontFamily="Segoe UI"/><Run Text="{Binding HeaderDirectory, Mode=OneWay}"/></TextBlock>
                    <TextBlock Margin="0,2"><Run Text="Reason  " Foreground="{StaticResource TextMuted}"/><Run Text="{Binding HeaderReason, Mode=OneWay}"/></TextBlock>
                    <TextBlock Margin="0,2" FontFamily="Consolas" FontSize="11.5"><Run Text="Date  " Foreground="{StaticResource TextMuted}" FontFamily="Segoe UI"/><Run Text="{Binding HeaderDate, Mode=OneWay}"/></TextBlock>
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Column header strip -->
        <Border Grid.Row="1" Background="#2F3236" BorderBrush="{StaticResource Border1}" BorderThickness="0,0,0,1" Padding="0">
            <TextBlock Text="All journal entries for this file" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="14,6"/>
        </Border>

        <!-- Full USN history -->
        <DataGrid Grid.Row="2" x:Name="HistoryGrid" ItemsSource="{Binding History}"
                  SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  Background="{StaticResource BgBase}" Foreground="{StaticResource TextPrimary}"
                  RowBackground="{StaticResource BgRow}" AlternatingRowBackground="{StaticResource BgRowAlt}"
                  BorderThickness="0" GridLinesVisibility="All" HorizontalGridLinesBrush="#3D4147" VerticalGridLinesBrush="#3D4147"
                  RowHeight="22"
                  materialDesign:DataGridAssist.CellPadding="8,2"
                  materialDesign:DataGridAssist.ColumnHeaderPadding="8,4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="USN" Binding="{Binding Usn}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11.5"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
                <DataGridTextColumn Header="Date" Binding="{Binding Timestamp, StringFormat=dd/MM/yyyy HH:mm:ss}" Width="160">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11.5"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Reason" Binding="{Binding Reason}" Width="*"/>
                <DataGridTextColumn Header="Directory" Binding="{Binding Directory}" Width="170">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="Consolas"/><Setter Property="FontSize" Value="11.5"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Footer -->
        <Border Grid.Row="3" Background="{StaticResource BgHeader}" BorderBrush="{StaticResource Border1}" BorderThickness="0,1,0,0" Padding="14,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center"
                           Text="{Binding History.Count, StringFormat='{}{0} journal entries'}"/>
                <Button DockPanel.Dock="Right" Content="Close" Style="{StaticResource FlatButton}"
                        Click="CloseClick" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
