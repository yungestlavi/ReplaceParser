<Application x:Class="SSForensic.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:conv="clr-namespace:SSForensic.Views"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
            <conv:FlagToBrushConverter x:Key="FlagToBrush"/>
            <conv:TrustToBrushConverter x:Key="TrustToBrush"/>
            <conv:BoolToVisConverter x:Key="BoolToVis"/>
            <conv:HasRunToScrimOpacityConverter x:Key="HasRunToScrim"/>

            <SolidColorBrush x:Key="ColorReplaceWithJava" Color="#E53935"/>
            <SolidColorBrush x:Key="ColorOriginalCheat"  Color="#1E88E5"/>
            <SolidColorBrush x:Key="ColorOriginalLegit"  Color="#43A047"/>
            <SolidColorBrush x:Key="ColorNoSignature"    Color="#FB8C00"/>
            <SolidColorBrush x:Key="ColorExtSpoofed"     Color="#8E24AA"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>